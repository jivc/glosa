{
  "name": "glosa",
  "version": "1.1.0",
  "description": "Glosa: análisis cualitativo de datos, sencillo, libre y multiplataforma.",
  "main": "electron/main.cjs",
  "scripts": {
    "publicar": "node scripts/publicar.mjs",
    "dev": "vite",
    "dev:app": "concurrently -k \"vite\" \"wait-on tcp:5199 && cross-env-shell GLOSA_DEV_URL=http://localhost:5199 electron .\"",
    "build": "tsc -p . && vite build",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "start": "electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": {
    "name": "Julio Vega"
  },
  "license": "MIT",
  "homepage": "https://example.org/glosa",
  "desktopName": "glosa.desktop",
  "type": "commonjs",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "docx": "^9.12.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "immer": "^11.1.21",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  },
  "productName": "Glosa",
  "build": {
    "appId": "mx.glosa.app",
    "productName": "Glosa",
    "copyright": "© 2026 Julio Vega",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "glosa",
        "name": "Proyecto de Glosa",
        "description": "Proyecto de análisis cualitativo",
        "mimeType": "application/x-glosa+zip",
        "role": "Editor",
        "icon": "build/icon"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": null
    },
    "dmg": {
      "title": "Glosa ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Glosa",
      "language": "3082"
    },
    "linux": {
      "target": [
        "rpm",
        "AppImage",
        "deb"
      ],
      "category": "Education;Science",
      "icon": "build/icons",
      "synopsis": "Análisis cualitativo de datos",
      "maintainer": "Julio Vega",
      "mimeTypes": [
        "application/x-glosa+zip"
      ],
      "desktop": {
        "entry": {
          "Name": "Glosa",
          "Comment": "Análisis cualitativo de datos",
          "Keywords": "qualitative;QDA;coding;cualitativo;",
          "StartupWMClass": "Glosa"
        }
      },
      "syncDesktopName": true
    },
    "rpm": {
      "depends": [
        "libXScrnSaver",
        "libnotify",
        "nss",
        "xdg-utils"
      ]
    }
  },
  "dependencies": {}
}